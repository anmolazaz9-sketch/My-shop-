# MONGODB_URI: Optional MongoDB connection string (e.g., MongoDB Atlas free cluster).
# When omitted, the app uses a persistent local JSON document database automatically.
MONGODB_URI=""

# JWT_SECRET: Secret used to sign customer and admin authentication tokens.
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"

# ADMIN_EMAIL / ADMIN_PASSWORD: Initial administrator credentials created on first boot.
ADMIN_EMAIL="admin@radhaclothesshop.in"
ADMIN_PASSWORD="RadhaAdmin@2026"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
